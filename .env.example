# Local runtime
CMS_PORT=8788
CMS_HOST=127.0.0.1
CMS_ALLOW_UNAUTHENTICATED=false
# Local UI only; never enable this in a production build.
VITE_CMS_ALLOW_UNAUTHENTICATED=false
CMS_DATABASE_DRIVER=sqlite
CMS_SQLITE_PATH=.data/echoes-studio.sqlite
CMS_DATABASE_MIGRATE=true
CMS_ADMIN_PASSWORD=replace-with-a-strong-login-password
CMS_SESSION_SECRET=replace-with-at-least-32-random-bytes
# Backwards-compatible alias for older deployments. Prefer CMS_ADMIN_PASSWORD.
# CMS_ADMIN_TOKEN=
CMS_INTERNAL_TOKEN=replace-with-a-long-random-token

# Repository connection (leave owner/repo empty until you connect GitHub)
# For local preview, set filesystem + the absolute path to a New Echoes checkout.
CMS_REPOSITORY_DRIVER=github
CMS_REPOSITORY_PATH=
CMS_GITHUB_OWNER=
CMS_GITHUB_REPO=
# Empty means: use the repository's default branch.
CMS_GITHUB_BRANCH=
CMS_CONTENT_ROOT=src/content
CMS_MAX_ARTICLE_BYTES=1048576
CMS_GITHUB_BLOB_CONCURRENCY=6

# GitHub App (recommended for production)
CMS_GITHUB_APP_ID=
CMS_GITHUB_INSTALLATION_ID=
CMS_GITHUB_PRIVATE_KEY=
# A short-lived installation token can be used for development only.
CMS_GITHUB_TOKEN=

# PostgreSQL / Supabase deployments
CMS_DATABASE_URL=
