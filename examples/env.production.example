# 这些值由 GitHub Action 注入运行平台，通常不需要手工创建此文件
CMS_DATABASE_URL=postgresql://replace-me
CMS_DATABASE_DRIVER=supabase
CMS_DATABASE_MIGRATE=false

# 以下都是可选高级覆盖项；普通用户无需配置
CMS_CONTENT_ROOT=src/content
CMS_ALLOW_UNAUTHENTICATED=false
CMS_SESSION_SECRET=replace-with-at-least-32-random-bytes
CMS_INTERNAL_TOKEN=replace-with-a-different-random-token
